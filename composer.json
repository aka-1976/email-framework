{
    "name": "your-org/email-framework",
    "description": "Modern PHP email framework with multiple transports and templating",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "symfony/mailer": "^6.0",
        "symfony/mime": "^6.0",
        "league/html-to-markdown": "^5.0",
        "psr/log": "^3.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "EmailFramework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EmailFramework\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --verbose",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse --level=max src/",
        "check": [
            "@cs-check",
            "@analyse",
            "@test"
        ]
    },
    "suggest": {
        "twig/twig": "Required for Twig templates",
        "illuminate/view": "Required for Blade templates",
        "predis/predis": "Required for Redis queue",
        "doctrine/dbal": "Required for database queue"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
