{
    "name": "aka-1976/email-framework",
    "description": "Modern PHP email framework with multiple transports and templating",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "symfony/mailer": "^6.0",
        "symfony/mime": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "EmailFramework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EmailFramework\\Tests\\": "tests/"
        }
    }
}